# Vercel environment variables. Replace placeholders before deployment.
# Only NEXT_PUBLIC_* values are exposed to browser code.
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=https://your-frontend-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.vercel.app
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# Server-only Better Auth database settings; never use NEXT_PUBLIC_ for these.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=jontrohaat

# Google OAuth credentials (client secret is private).
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
# Register https://your-frontend-domain.vercel.app/api/auth/callback/google
# as an authorized Google OAuth redirect URI.
